{
  "manifest_version": 3,
  "name": "Reply Guy - Crypto Twitter Tool",
  "version": "1.8.0",
  "description": "Context-aware crypto Twitter engagement tool with persona-based replies and variants",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://reply-guy-eta.vercel.app/*",
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reply Guy"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}